# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/proofofclass?schema=public"

# ---------------------------------------------------------------------------
# Auth (SIWE + Auth.js v5). Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
# Public URL of the deployed app. On the VPS this must match the nginx host,
# e.g. AUTH_URL="https://class.jigmenidup.site" — otherwise SIWE, cookies and
# Socket.io all disagree about the origin.
# HOSTNAME="class.jigmenidup.site"

# ---------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------
# 31337 = local Hardhat node, 11155111 = Sepolia
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL="http://127.0.0.1:8545"

# Used when NEXT_PUBLIC_CHAIN_ID=11155111. Avoid rpc.sepolia.org (serves an
# HTML block page) and 1rpc.io (caps eth_getLogs at 50 blocks, which starves
# the indexer). Prefer a dedicated Alchemy/Infura key for real use.
NEXT_PUBLIC_SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# Address of the deployed ClassroomFactory. Written by `npm run contracts:deploy`.
NEXT_PUBLIC_FACTORY_ADDRESS=""

# Wallet that can approve trainer requests. Must be an address you control in
# MetaMask. Shown in the header as Admin. Authority is the SIWE signature, not
# secrecy of the value.
NEXT_PUBLIC_PLATFORM_OWNER_ADDRESS=""

# Deployer key used only by scripts/deploy.ts.
# This is Hardhat's well-known account #0 - NEVER use it on a public network.
DEPLOYER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# ---------------------------------------------------------------------------
# Indexer
# ---------------------------------------------------------------------------
# 4000 suits instant local blocks; use ~12000 on Sepolia to save RPC quota.
INDEXER_POLL_INTERVAL_MS=4000
# How many blocks to scan per request (keep low for public RPCs)
INDEXER_BLOCK_RANGE=2000
